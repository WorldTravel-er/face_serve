{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "face-serve offline package manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "name",
    "version",
    "source_commit",
    "profile",
    "architecture",
    "python",
    "config_sample",
    "system_packages",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"const": "face-serve"},
    "version": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "minLength": 1},
    "profile": {
      "enum": [
        "rk3588-rknn",
        "linux-x86_64-onnx-cpu",
        "linux-x86_64-onnx-cuda"
      ]
    },
    "architecture": {"enum": ["aarch64", "x86_64"]},
    "python": {"const": ">=3.11,<3.13"},
    "config_sample": {"type": "string"},
    "system_packages": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  }
}
