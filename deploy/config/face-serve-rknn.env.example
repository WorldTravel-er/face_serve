FACE_API_HOST=0.0.0.0
FACE_API_PORT=8000
FACE_API_RUNTIME=rknn
FACE_API_PROVIDER=cpu
FACE_API_DATA_DIR=/var/lib/face-serve
FACE_API_RETINAFACE_RKNN=/opt/face-serve/current/models/rknn/retinaface-mobilenet0.25-480x720-int8.rknn
FACE_API_CVLFACE_RECOGNITION_RKNN=/opt/face-serve/current/models/rknn/recognition-int8.rknn
FACE_API_CVLFACE_ALIGNER_ONNX=/opt/face-serve/current/models/onnx/cvlface_dfa_mobilenet.onnx
FACE_API_RKNN_MANIFEST=/opt/face-serve/current/models/rknn/manifest.json
FACE_API_RKNN_DETECTOR_CORE_MASK=0
FACE_API_RKNN_RECOGNITION_CORE_MASK=1
FACE_API_RKNN_ALIGNER_FALLBACK=onnx-cpu
FACE_API_RKNN_RUNTIME_LIBRARY=/usr/lib/librknnrt.so
FACE_API_RKNN_DEVICE=/dev/dri/renderD129
FACE_API_LIVE_STREAM_URL=rtsp://127.0.0.1:8554/camera
FACE_API_LIVE_VIDEO_STREAM_ID=camera
FACE_API_VIDEO_ANALYSIS_DETECTION_FRAME_STRIDE=2
FACE_API_VIDEO_ANALYSIS_TRACK_BUFFER_FRAMES=30
FACE_API_VIDEO_ANALYSIS_MIN_TRACK_HITS=3
FACE_API_VIDEO_ANALYSIS_RECOGNITION_QUEUE_SIZE=16
